# 📁 FILE: .env.production
# 📏 LINES: 1-16
# 🎯 PURPOSE: Production environment variables for Vercel deployment (Frontend ONLY)
# 🔒 SECURITY: VITE_ prefix exposes to browser. AI keys MUST stay in Supabase Secrets. Never commit real values.
# ⚠️ SAFETY: Strict typing comments, fallback warnings, clear separation of client/server vars

# 🔑 FRONTEND PUBLIC VARS (Vercel Project Settings → Environment Variables)
VITE_SUPABASE_URL=https://your-project-id.supabase.co  // Line 7 → Supabase Project URL
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...         // Line 8 → Public Anon Key (secured by RLS)
VITE_APP_NAME=OURHEART                                  // Line 9 → App identifier for meta/SEO
VITE_CHAT_ENDPOINT=/functions/v1/chatHandler            // Line 10 → Edge Function route

# ⚠️ SERVER-ONLY KEYS (DO NOT PUT IN VERCEL)
# These belong in Supabase CLI: `supabase secrets set GROQ_API_KEY=xxx CEREBRAS_API_KEY=xxx`
# GROQ_API_KEY=sk-...                                   // Line 13 → Kept commented. Server-only.
# CEREBRAS_API_KEY=cs-...                               // Line 14 → Kept commented. Server-only.

// Line 16 → EOF
