# 📁 FILE: .env.example
# 📏 LINES: 1-18
# 🎯 PURPOSE: Safe template for team/deployment. NEVER contains real keys.
# 🔒 SECURITY: Only VITE_ prefixed vars are exposed to frontend. AI keys stay server-only.

# 🔑 FRONTEND PUBLIC VARS (Safe with Supabase RLS)
VITE_SUPABASE_URL=      // Line 5 → Supabase project URL (public)
VITE_SUPABASE_ANON_KEY= // Line 6 → Public anon key (secured by RLS policies)
VITE_APP_NAME=OURHEART  // Line 7 → App display name for SEO/meta

# 🌐 BACKEND SERVER VARS (Edge Functions ONLY)
# ⚠️ NEVER prefix these with VITE_. They must only exist in Supabase Secrets.
GROQ_API_KEY=           // Line 10 → Groq inference key (server-only)
CEREBRAS_API_KEY=       // Line 11 → Cerebras fallback key (server-only)
VITE_CHAT_ENDPOINT=/functions/v1/chatHandler // Line 12 → Secure API route
